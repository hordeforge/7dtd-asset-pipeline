using System.Collections.Generic;
using UnityEngine;
using ZdtdPlaytest;

// Generated by `shamway acceptance-provider` for {MOD_NAME}. Edit the
// generator, not this file: it is rewritten on every run.
//
// This is the half of bundle acceptance that no offline gate can reach. A
// Unity runtime of the game's revision loading the bundle (`shamway
// verify-bundle`) proves construction; it does not run the game's own
// resolution chain — DataLoader.ParseDataPathIdentifier rewriting
// @modfolder(Name), AssetBundleManager.LoadAssetBundle opening the archive,
// and AssetBundleManager._get reducing an asset request to its file-name
// stem. These cases run that chain inside the live client, so a pass is the
// game itself saying it can read what this pipeline staged.
//
// It still proves nothing about how the asset looks or sounds. That remains a
// person's judgement, recorded with `shamway client capture`.
public sealed class {CLASS_NAME} : IScenarioProvider
{{
    private const string Bundle =
        "#@modfolder({MOD_NAME}):{BUNDLE_URI_PATH}";

    public IEnumerable<string> SuiteIds
    {{
        get
        {{
            yield return "{SUITE_ID}";
            {LOOK_YIELDS}
        }}
    }}

    public void AppendSuite(List<CaseDef> queue, string suite, int lap)
    {{
        RejectMixedVisualSuites();
        string label = lap > 0 ? suite + "@" + lap : suite;
        {LOOK_BRANCH}
{CASES}
        // A stem the bundle does not contain must still come back null, so a
        // pass above cannot be a loader that answers every request.
        Object absent = null;
        queue.Add(CaseDef.Live(label, "absent_stem_is_null", new[] {{ "bundle" }},
            act: ctx =>
            {{
                absent = DataLoader.LoadAsset<Object>(Bundle + "?{ABSENT_STEM}");
                Report.Info("absent_stem: " + (absent == null ? "null (expected)" : absent.name));
            }},
            assert: ctx => absent == null,
            fail: "a stem the bundle does not contain resolved to an object"));
    }}

    // A prefab hanging in front of the camera (*_look) and a block sitting on
    // a voxel (*_block_*) are different pictures. Mixing them in one
    // PLAYTEST_SUITE list is how a self-test rendered a texture mid-air AND a
    // placed block in the same session. Refuse it here, not after someone has
    // already watched both.
    static void RejectMixedVisualSuites()
    {{
        var raw = System.Environment.GetEnvironmentVariable("PLAYTEST_SUITE") ?? "";
        bool look = false, block = false;
        foreach (var token in raw.Split(new char[] {{ ',', ';', ' ', '\t' }},
                     System.StringSplitOptions.RemoveEmptyEntries))
        {{
            if (token.EndsWith("_look")) look = true;
            if (token.IndexOf("_block_", System.StringComparison.Ordinal) >= 0) block = true;
        }}
        if (look && block)
        {{
            throw new System.InvalidOperationException(
                "PLAYTEST_SUITE mixes a prefab-look suite (*_look) and a "
                + "block-placement suite (*_block_*); they are different pictures. "
                + "Run them as separate playtest invocations.");
        }}
    }}
}}
