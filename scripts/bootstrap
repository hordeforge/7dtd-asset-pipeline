#!/usr/bin/env bash
# Install this checkout into an isolated local virtual environment with uv.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$ROOT/.venv"
EXTRAS="${EXTRAS:-all}"

usage() {
	cat <<'HELP'
Create .venv and install this checkout into it.

USAGE
  scripts/bootstrap [--no-extras]

OPTIONS
  --no-extras   Install only the dependency-free core, without the optional
                capabilities (lz4 writer support, Pillow, NumPy, trimesh)
  -h, --help    Show this help

Uses uv for every Python step. Install it, and everything else, with
scripts/install-tools.sh.
HELP
}

while (($#)); do
	case "$1" in
		--no-extras) EXTRAS=""; shift ;;
		-h|--help) usage; exit 0 ;;
		*) echo "ERROR: unknown option $1" >&2; usage >&2; exit 1 ;;
	esac
done

if ! command -v uv >/dev/null 2>&1; then
	cat >&2 <<'MISSING'
ERROR: uv is required and was not found on PATH.

Install it with:
  scripts/install-tools.sh

or see https://docs.astral.sh/uv/ for other installation methods.
MISSING
	exit 1
fi

# uv sync resolves from the committed uv.lock and verifies its hashes, so
# every checkout installs exactly the versions the repository pinned instead
# of whatever PyPI serves today. --locked keeps that promise when the
# manifest has drifted from the lock: it fails and asks for a deliberate
# `uv lock` rather than silently resolving fresh against PyPI. It creates
# .venv and provisions an interpreter itself when the host has none new
# enough, so the Python version is a constraint here rather than a
# prerequisite. The dev group (ruff, mypy, setuptools, coverage) rides along so
# `make check test` works out of the box.
#
# The version is the one .python-version pins, not an open range: a range
# resolved on a host with 3.15 installed builds a .venv out of the matrix CI
# tests and out of the version the release artifact is built with. The floor in
# pyproject.toml still says what the package supports; this says what this
# checkout develops against.
PINNED_PYTHON="$(tr -d '[:space:]' < "$ROOT/.python-version")"
if [[ -z "$PINNED_PYTHON" ]]; then
	cat >&2 <<'MISSING'
ERROR: .python-version is empty or unreadable; it is the pinned interpreter.

Restore it, or pass an explicit --python to uv sync yourself.
MISSING
	exit 1
fi
SYNC_ARGS=(--locked --project "$ROOT" --python "$PINNED_PYTHON")
if [[ -n "$EXTRAS" ]]; then
	IFS=',' read -r -a extras <<<"$EXTRAS"
	for extra in "${extras[@]}"; do
		SYNC_ARGS+=(--extra "$extra")
	done
fi
uv sync "${SYNC_ARGS[@]}"

cat <<EOF
Installed the pipeline in $VENV

Run:
  $VENV/bin/shamway --help

Or, without activating anything:
  uv run --project $ROOT shamway --help

For a user-wide command instead (resolves fresh, outside the lock):
  uv tool install $ROOT
EOF
