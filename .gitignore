.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
.shamway/
.local.env

# Unity working state. Project source, settings, and .meta files stay tracked.
**/Library/
**/Temp/
**/Logs/
**/UserSettings/
**/MemoryCaptures/
**/Recordings/
**/*.csproj
**/*.sln

# Staged by setup.py so `shamway docs` works from a wheel; not a source of truth.
src/sevendtd_asset_pipeline/docs/
src/sevendtd_asset_pipeline/scripts/

.claude
.agents
.scratch/
.gauntlet.lock.coverage.json
# Other lockfiles stay local, but this project's own uv.lock is committed:
# it pins the dev toolchain and every transitive version for CI and
# contributor checkouts, and `uv sync --locked` verifies its hashes.
# Published wheels still declare open ranges, so consumers are unaffected.
*.lock
!uv.lock

*.ignore
.local/
