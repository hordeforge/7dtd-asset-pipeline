#!/usr/bin/env bash
# Install this checkout into an isolated local virtual environment with uv.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$ROOT/.venv"
EXTRAS="${EXTRAS:-all}"

usage() {
	cat <<'HELP'
Create .venv and install this checkout into it.

USAGE
  scripts/bootstrap [--no-extras]

OPTIONS
  --no-extras   Install only the dependency-free core, without the optional
                capabilities (UnityPy, Pillow, NumPy, trimesh)
  -h, --help    Show this help

Uses uv for every Python step. Install it, and everything else, with
scripts/install-tools.sh.
HELP
}

while (($#)); do
	case "$1" in
		--no-extras) EXTRAS=""; shift ;;
		-h|--help) usage; exit 0 ;;
		*) echo "ERROR: unknown option $1" >&2; usage >&2; exit 1 ;;
	esac
done

if ! command -v uv >/dev/null 2>&1; then
	cat >&2 <<'MISSING'
ERROR: uv is required and was not found on PATH.

Install it with:
  scripts/install-tools.sh

or see https://docs.astral.sh/uv/ for other installation methods.
MISSING
	exit 1
fi

# uv sync resolves from the committed uv.lock and verifies its hashes, so
# every checkout installs exactly the versions the repository pinned instead
# of whatever PyPI serves today. It creates .venv and provisions an
# interpreter itself when the host has none new enough, so the Python version
# is a constraint here rather than a prerequisite. The dev group (ruff, mypy,
# setuptools) rides along so `make check test` works out of the box.
SYNC_ARGS=(--project "$ROOT" --python '>=3.11')
if [[ -n "$EXTRAS" ]]; then
	IFS=',' read -r -a extras <<<"$EXTRAS"
	for extra in "${extras[@]}"; do
		SYNC_ARGS+=(--extra "$extra")
	done
fi
uv sync "${SYNC_ARGS[@]}"

cat <<EOF
Installed the pipeline in $VENV

Run:
  $VENV/bin/shamway --help

Or, without activating anything:
  uv run --project $ROOT shamway --help

For a user-wide command instead (resolves fresh, outside the lock):
  uv tool install $ROOT
EOF
