#!/usr/bin/env bash
# Guide or run installation of a game-matched Unity Editor and Windows module.
set -euo pipefail

VERSION=""
CHANGESET=""
RUN=0

usage() {
	cat <<'EOF'
Usage: scripts/setup-unity --version VERSION [--changeset HASH] [--run]

Prints the exact Unity CLI command needed for the pipeline. With --run, invokes
the installed experimental Unity CLI. Account sign-in and license activation
remain user-owned actions and are never scripted or read from environment.

Find VERSION authoritatively with:
  7dtd-assets init /path/to/MyMod --game-dir "/path/to/7 Days To Die"

Find a changeset in Unity's official download archive only when the requested
version is absent from the CLI release feed.
EOF
}

while (($#)); do
	case "$1" in
		--version) VERSION="${2:?--version needs a value}"; shift 2 ;;
		--changeset) CHANGESET="${2:?--changeset needs a value}"; shift 2 ;;
		--run) RUN=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) echo "ERROR: unknown option $1" >&2; usage >&2; exit 1 ;;
	esac
done

if [[ -z "$VERSION" ]]; then
	echo "ERROR: --version is required." >&2
	exit 1
fi

COMMAND=(unity install "$VERSION")
if [[ -n "$CHANGESET" ]]; then
	COMMAND+=(-c "$CHANGESET")
fi
COMMAND+=(-m windows-mono)

printf 'Required editor install command:'
printf ' %q' "${COMMAND[@]}"
printf '\n'
echo "After installation, sign in/activate through Unity's supported flow and set UNITY_EDITOR."

if ((RUN)); then
	if ! command -v unity >/dev/null 2>&1; then
		echo "ERROR: Unity CLI is not installed. See docs/setup.md." >&2
		exit 1
	fi
	"${COMMAND[@]}"
fi
