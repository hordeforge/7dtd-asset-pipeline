.venv/
# This is a library published for others to install, not a pinned application,
# so consumers resolve their own dependencies. uv run writes this locally.
uv.lock
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.asset-pipeline/
.local.env

# Unity working state. Project source, settings, and .meta files stay tracked.
**/Library/
**/Temp/
**/Logs/
**/UserSettings/
**/MemoryCaptures/
**/Recordings/
**/*.csproj
**/*.sln

# Staged by setup.py so `7dtd-assets docs` works from a wheel; not a source of truth.
src/sevendtd_asset_pipeline/docs/
build/
dist/
